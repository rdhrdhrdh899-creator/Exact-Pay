rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying across all users

      allow create: if isOwner(userId) 
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && (incoming().provider in ['google', 'phone', 'multiple']);

      allow update: if isOwner(userId)
        && incoming().uid == existing().uid; // UID is immutable

      allow delete: if isOwner(userId);

      // User Saved QRs sub-collection
      match /saved_qrs/{qrId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(qrId)
          && incoming().userId == request.auth.uid
          && (incoming().type in ['upi', 'bank']);

        allow update: if isOwner(userId)
          && incoming().userId == existing().userId;

        allow delete: if isOwner(userId);
      }
    }
  }
}
